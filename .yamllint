---
# .yamllint for k8s-factory project
extends: default

rules:
  line-length:
    max: 120
    level: warning
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no', 'on', 'off']
  comments:
    min-spaces-from-content: 1
  document-start:
    present: true
  indentation:
    spaces: 2
    indent-sequences: consistent

ignore: |
  .git/
  node_modules/
  */target/
  services/aggregator/target/
